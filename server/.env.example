MONGODB_URI=mongodb://127.0.0.1:27017/lead_crm
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
PORT=4000
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173
NODE_ENV=development

# SMTP provider settings used for role invitation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Lead CRM <no-reply@example.com>
INVITE_EXPIRES_HOURS=72

# Twilio credentials used to send SMS/WhatsApp messages from the CRM (click-to-call itself
# needs no server config - it's a tel: link in the client). Get these from twilio.com/console;
# TWILIO_SMS_FROM is a Twilio phone number, TWILIO_WHATSAPP_FROM is a WhatsApp-enabled sender
# (e.g. the Twilio sandbox number while testing, or your approved WhatsApp Business number).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# To receive replies too: create a "WhatsApp" intake channel under Configuration, then point
# Twilio's WhatsApp sender "A message comes in" webhook at
# https://<your-api-host>/api/public/whatsapp?key=<that channel's API key> (POST). A reply from a
# number already in the CRM appends to that lead/deal/contact/company's timeline; an unknown
# number becomes a new lead through the normal capture funnel.

# Automation engine - see server/src/services/automation.service.ts and ingestion.service.ts.
# How long a salesperson has before the lead-capture follow-up task is due.
FOLLOW_UP_SLA_HOURS=4
# A lead scoring at or above this (see scoring.service.ts - recomputed on every new signal, not
# just at capture) is auto-flagged HOT.
HOT_SCORE_THRESHOLD=70
# A new lead with no logged contact after this many minutes is escalated to its manager.
UNCONTACTED_ESCALATE_MINUTES=15
# An open deal that stays in one pipeline stage this many days triggers a stale-deal notification
# and follow-up task.
STALE_STAGE_DAYS=5
# How often the automation engine re-scans for the two rules above. Set to 0 to disable the sweep.
AUTOMATION_INTERVAL_MINUTES=5
