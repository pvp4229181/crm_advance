MONGODB_URI=mongodb://127.0.0.1:27017/lead_crm
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
PORT=4000
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173
NODE_ENV=development

# OpenRouter AI (server-side only). Get a key from https://openrouter.ai/keys
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Official Meta WhatsApp Cloud API (server-side only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Needed to sync approved message templates from Meta
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_GRAPH_VERSION=v23.0

# SMTP provider settings used for role invitation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Lead CRM <no-reply@example.com>
INVITE_EXPIRES_HOURS=72

# Authenticates hosted WhatsApp recovery jobs; use a random secret.
CRON_SECRET=
